{
  "name": "rust-rsc-prototype",
  "private": true,
  "scripts": {
    "catalog:data": "node catalog/generate-data.js",
    "catalog:service": "node catalog/data-service.js",
    "catalog:dev:next-js": "node catalog/run-variant.js next-js",
    "catalog:dev:next-wasm": "node catalog/run-variant.js next-wasm",
    "catalog:dev:native-fallback": "node catalog/run-variant.js native-fallback",
    "catalog:dev:native-only": "node catalog/run-variant.js native-only",
    "catalog:benchmark-architectures": "node catalog/benchmark-architectures.js",
    "catalog:benchmark-report": "node catalog/benchmark-architectures.js --render-existing",
    "catalog:test-architectures": "playwright test --config catalog/playwright.config.js",
    "vercel:build": "node build-vercel-output.js",
    "vercel:build:all": "node build-vercel-output.js --all",
    "vercel:deploy:next-js": "vercel deploy --build-env RUST_RSC_VERCEL_MODE=next-js",
    "vercel:deploy:next-wasm": "vercel deploy --build-env RUST_RSC_VERCEL_MODE=next-wasm",
    "vercel:deploy:native-fallback": "vercel deploy --build-env RUST_RSC_VERCEL_MODE=native-fallback",
    "vercel:deploy:native-only": "vercel deploy --build-env RUST_RSC_VERCEL_MODE=native-only",
    "vercel:validate": "node validate-vercel-output.js",
    "vercel:test": "pnpm vercel:build:all && pnpm vercel:validate && playwright test --config catalog/vercel-output.playwright.config.js",
    "dev": "node ../packages/next/dist/bin/next dev --webpack --port 3027",
    "generate-native-manifest": "node generate-native-manifest.js",
    "package-native": "node package-native-deployment.js",
    "test-loader-diagnostics": "node test-loader-diagnostics.js"
  }
}
