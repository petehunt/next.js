{
  "name": "@next/rs",
  "version": "16.3.1-canary.22",
  "keywords": [
    "react",
    "next",
    "next.js",
    "rust",
    "next-rs"
  ],
  "description": "Build tooling and browser runtime for next-rs, the progressive Rust runtime for Next.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/next.js",
    "directory": "packages/next-rs"
  },
  "author": "Next.js Team <support@vercel.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "next-rs": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "scripts": {
    "prebuild": "node ../../scripts/rm.mjs dist",
    "build": "tsc",
    "types": "tsc --noEmit"
  }
}
